{
  "name": "vplusplus",
  "displayName": "v++ Language",
  "description": "Syntax highlighting, F5 run, diagnostics, and completion for the v++ programming language (.vpp files).",
  "version": "0.4.0",
  "publisher": "vpp-lang",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1a1a1a",
    "theme": "dark"
  },
  "keywords": [
    "vpp",
    "v++",
    "programming language",
    "vpp-lang"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shauryaR790/V-.git"
  },
  "bugs": {
    "url": "https://github.com/shauryaR790/V-/issues"
  },
  "homepage": "https://github.com/shauryaR790/V-#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:vpp"
  ],
  "main": "./extension.js",
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "vpp",
        "aliases": ["v++", "vpp"],
        "extensions": [".vpp"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/vpp.png",
          "dark": "./icons/vpp-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "vpp",
        "scopeName": "source.vpp",
        "path": "./syntaxes/vpp.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "vpp-icons",
        "label": "v++ Icons",
        "path": "./icons/vpp-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "vpp.runFile",
        "title": "v++: Run File",
        "icon": "$(play)"
      },
      {
        "command": "vpp.checkFile",
        "title": "v++: Check File",
        "icon": "$(check)"
      },
      {
        "command": "vpp.testProject",
        "title": "v++: Run Tests",
        "icon": "$(beaker)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "vpp.runFile",
          "when": "resourceLangId == vpp",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "vpp.runFile",
          "when": "resourceLangId == vpp",
          "group": "navigation@1"
        },
        {
          "command": "vpp.checkFile",
          "when": "resourceLangId == vpp",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "vpp.runFile",
          "when": "resourceLangId == vpp"
        },
        {
          "command": "vpp.checkFile",
          "when": "resourceLangId == vpp"
        },
        {
          "command": "vpp.testProject"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vpp.runFile",
        "key": "ctrl+shift+r",
        "when": "resourceLangId == vpp && editorTextFocus"
      },
      {
        "command": "vpp.runFile",
        "key": "f5",
        "when": "resourceLangId == vpp && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "v++",
      "properties": {
        "vpp.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to vpp.exe. Leave empty to auto-detect (vpp.ps1 or target/debug/vpp.exe in workspace)."
        },
        "vpp.languageServerPath": {
          "type": "string",
          "default": "vppls",
          "description": "Path to the v++ language server (build with: cargo build --features lsp --bin vppls)"
        },
        "vpp.enableLanguageServer": {
          "type": "boolean",
          "default": true,
          "description": "Start vppls automatically for diagnostics, completion, and go-to-definition."
        }
      }
    }
  }
}
