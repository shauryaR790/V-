pub fn upper(s: string) -> string {
    return s
}

pub fn repeat(s: string, n: int) -> string {
    let out = ""
    let i = 0
    while i < n {
        out = out + s
        i = i + 1
    }
    return out
}

pub fn len_str(s: string) -> int {
    return len(s)
}

pub fn is_empty(s: string) -> bool {
    return len(s) == 0
}
