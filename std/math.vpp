fn add(a: int, b: int) -> int {
    return a + b
}

fn abs(n: int) -> int {
    if n < 0 {
        return 0 - n
    }
    return n
}

fn max(a: int, b: int) -> int {
    if a > b {
        return a
    }
    return b
}

fn min(a: int, b: int) -> int {
    if a < b {
        return a
    }
    return b
}

fn pow(base: int, exp: int) -> int {
    let result = 1
    let i = 0
    while i < exp {
        result = result * base
        i = i + 1
    }
    return result
}
