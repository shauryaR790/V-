import std.fs
import std.json
import std.process

enum Status {
    Active
    Inactive
}

struct User {
    name: string
    age: int
    status: Status
}

fn add(a: int, b: int) -> int {
    return a + b
}

fn describe(status: Status) -> string {
    match status {
        Active => {
            return "active"
        }
        Inactive => {
            return "inactive"
        }
    }
}

fn ok_val() -> Result<int, string> {
    return Ok(42)
}

fn main() -> int {
    print("=== v++ hello ===")

    print(add(10, 20))

    let numbers = [1, 2, 3, 4, 5]
    for n in numbers {
        print(n)
    }

    let total = 0
    for i in 0..5 {
        total = total + numbers[i]
    }
    print(total)

    let user = User {
        name: "Shaurya"
        age: 18
        status: Active
    }
    print(user.name)
    print(user.age)
    print(describe(user.status))

    let r = ok_val()
    match r {
        Ok(n) => {
            print(n)
        }
        Err(e) => {
            print(e)
        }
    }

    let j = json.parse("{\"language\":\"v++\",\"version\":\"0.3\"}")
    print(json.stringify(j))

    fs.write("vpp_test.txt", "v++ filesystem test")
    print(fs.exists("vpp_test.txt"))
    print(fs.read("vpp_test.txt"))

    let code = process.run("echo vpp process test")
    print(code)

    print("=== done ===")
    return 0
}
