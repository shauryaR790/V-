{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "v++: Run current file",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\vpp.ps1\" run \"${file}\""
    },
    {
      "name": "v++: Check current file",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\vpp.ps1\" check \"${file}\""
    }
  ]
}
